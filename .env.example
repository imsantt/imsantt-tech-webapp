# Autenticação
# Provider ativo:
#   "api"      backend proprietário (padrão)
#   "supabase" plano B (BaaS)
#   "mock"     stub de desenvolvimento (token fake em localStorage, sem backend)
VITE_AUTH_PROVIDER=api
# URL base da API proprietária (imsantt-tech-api)
VITE_API_URL=http://localhost:3000

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare R2
VITE_R2_PUBLIC_URL=https://your-r2-bucket.r2.dev

# Sentry (apenas produção — deixe vazio para desabilitar)
VITE_SENTRY_DSN=

# Sentry Source Maps (build-time — usado apenas no CI/deploy)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
