# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare R2
VITE_R2_PUBLIC_URL=https://your-r2-bucket.r2.dev

# Sentry (apenas produção — deixe vazio para desabilitar)
VITE_SENTRY_DSN=

# Sentry Source Maps (build-time — usado apenas no CI/deploy)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Autenticação GitHub OAuth (Cloudflare Pages Functions) ─────────────────
# Estas variáveis NÃO têm prefixo VITE_ — vivem apenas no servidor
# (Cloudflare Pages → Settings → Environment variables) e nunca entram no
# bundle do cliente. Não versione valores reais.

# Credenciais do GitHub OAuth App (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Segredo para assinar o cookie de sessão (HMAC). Gere um valor aleatório forte,
# ex.: `openssl rand -base64 48`
SESSION_SECRET=

# Allowlist do proprietário — só estas contas do GitHub têm acesso ao painel.
# Aceita múltiplos valores separados por vírgula. Prefira o id (imutável).
GITHUB_ALLOWED_LOGINS=seu-usuario-github
GITHUB_ALLOWED_IDS=

# Origem canônica para montar o redirect_uri. OBRIGATÓRIA em produção (HTTPS)
# — não é derivada do host da requisição por segurança. Ex.: https://imsantt.tech
APP_ORIGIN=

# Versão da sessão. Incremente para invalidar todas as sessões (logout global).
# Opcional — padrão 1.
SESSION_VERSION=1
